{
  "name": "claude-discord-bot-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "discord-bot"
  ],
  "scripts": {
    "start:backend": "npm start --workspace=backend",
    "start:bot": "npm start --workspace=discord-bot",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:bot": "npm run dev --workspace=discord-bot",
    "build": "npm install --workspaces"
  },
  "engines": {
    "node": ">=20 <27"
  },
  "license": "MIT"
}
